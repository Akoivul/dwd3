FROM node:16-alpine

WORKDIR /usr/src/app

COPY code/example-frontend .

ENV REACT_APP_BACKEND_URL=http://localhost:8080

RUN npm install && \
    npm run build && \
    npm install -g serve && \
    rm -rf node_modules src && \
    npm cache clean --force && \
    adduser -D appuser

USER appuser

EXPOSE 5001

CMD ["serve", "-s", "-l", "5001", "build"]